diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index xxxxxxx..yyyyyyy 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -132,6 +132,7 @@ struct msm_dsi_host {
 	u32 dma_cmd_ctrl_restore;
 	bool registered;
 	bool power_on;
+	bool enabled;
 	int irq;
 };

@@ -1192,24 +1192,51 @@ static void dsi_wait4video_done(struct msm_dsi_host *msm_host)

 static void dsi_wait4video_eng_busy(struct msm_dsi_host *msm_host)
 {
-	if (!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
-		return;
-	if (msm_host->power_on) {
-		dsi_wait4video_done(msm_host);
-		/* delay 4 ms to skip BLLP */
-		usleep_range(2000, 4000);
-	}
+	u32 data;
+	unsigned long timeout;
+
+	data = dsi_read(msm_host, REG_DSI_STATUS0);
+
+	if (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) {
+		if (!(data & DSI_STATUS0_VIDEO_MODE_ENGINE_BUSY))
+			return;
+	} else {
+		if (!(data & DSI_STATUS0_CMD_MODE_ENGINE_BUSY))
+			return;
+
+		timeout = jiffies + msecs_to_jiffies(70);
+		do {
+			usleep_range(50, 100);
+			data = dsi_read(msm_host, REG_DSI_STATUS0);
+		} while ((data & DSI_STATUS0_CMD_MODE_ENGINE_BUSY) &&
+			 time_before(jiffies, timeout));
+
+		if (data & DSI_STATUS0_CMD_MODE_ENGINE_BUSY)
+			DRM_DEV_ERROR(&msm_host->pdev->dev,
+				      "wait for cmd mode engine idle timed out\n");
+		return;
+	}
+
+	if (msm_host->power_on && msm_host->enabled) {
+		dsi_wait4video_done(msm_host);
+		usleep_range(2000, 4000);
+	}
 }

@@ -2444,8 +2471,17 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 	 * mdp clock need to be enabled to receive dsi interrupt
 	 */
 	pm_runtime_get_sync(&msm_host->pdev->dev);
-	dsi_link_clk_enable(msm_host);
+
+	/*
+	 * The active command‑mode display already owns the DSI link clocks.
+	 * Retuning/re‑enabling them while CMD MDP is pushing a TE‑triggered
+	 * frame can starve the DSI HS lane FIFOs. Only acquire link clocks
+	 * here when the host is not already powering an enabled display.
+	 */
+	if (!msm_host->power_on || !msm_host->enabled) {
+		dsi_link_clk_enable(msm_host);
+	}

 	/* TODO: vote for bus bandwidth */

@@ -2476,7 +2511,8 @@ void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,

 	/* TODO: unvote for bus bandwidth */

-	dsi_link_clk_disable(msm_host);
+	if (!msm_host->power_on || !msm_host->enabled)
+		dsi_link_clk_disable(msm_host);
 	pm_runtime_put_autosuspend(&msm_host->pdev->dev);
 }

diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index xxxxxxx..yyyyyyy 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -424,6 +424,10 @@ static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge)
 		ret = msm_dsi_host_enable(msm_dsi1->host);
 		if (ret)
 			goto host1_en_fail;
 	}
+	/* mark host enabled after host_enable success */
+	msm_dsi->host->enabled = true;
+	if (is_dual_dsi && msm_dsi1)
+		msm_dsi1->host->enabled = true;

 	if (panel) {
 		ret = drm_panel_enable(panel);
@@ -479,6 +483,10 @@ static void dsi_mgr_bridge_post_disable(struct drm_bridge *bridge)
 		ret = msm_dsi_host_disable(msm_dsi1->host);
 		if (ret)
 			pr_err("%s: host1 disable failed, %d\n", __func__, ret);
 	}
+	/* clear host enabled flag after host_disable */
+	msm_dsi->host->enabled = false;
+	if (is_dual_dsi && msm_dsi1)
+		msm_dsi1->host->enabled = false;

 	if (panel) {
 		ret = drm_panel_unprepare(panel);